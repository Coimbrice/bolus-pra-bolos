{
  "name": "bolus-pra-bolos",
  "version": "0.1.0",
  "description": "Insulin bolus calculation library based on Think Like a Pancreas. A programming exercise, not a medical device.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "diabetes",
    "insulin",
    "bolus",
    "carb-counting",
    "type-1-diabetes"
  ],
  "author": "Luís Coimbra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coimbrice/bolus-pra-bolos.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
